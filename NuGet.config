<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Cleared on purpose. Central Package Management plus TreatWarningsAsErrors turns an
    unexpected feed into NU1507, a hard build error, on any machine that has extra sources
    configured globally. Pinning the feed list here keeps restore identical everywhere.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

</configuration>
